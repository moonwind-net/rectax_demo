# Optional env overrides for remote-ingest-agent
# Prefix: RECTAX_AGENT_

RECTAX_AGENT_API_BASE_URL=http://127.0.0.1:8000
RECTAX_AGENT_API_PREFIX=/api/v1
RECTAX_AGENT_LOGIN_EMAIL=admin@example.com
RECTAX_AGENT_LOGIN_PASSWORD=CHANGE_ME

# Comma-separated for list fields if overriding YAML
# RECTAX_AGENT_WATCH_DIRS=/mnt/share1,/mnt/share2
# RECTAX_AGENT_INCLUDE_PATTERNS=*.jpg,*.jpeg,*.png,*.pdf

RECTAX_AGENT_BATCH_MAX_FILES=3
RECTAX_AGENT_BATCH_MAX_TOTAL_MB=100
RECTAX_AGENT_DELAY_SECONDS=2
RECTAX_AGENT_MAX_RETRIES=3
RECTAX_AGENT_RETRY_BASE_SECONDS=3
RECTAX_AGENT_HEALTH_POLL_SECONDS=5
RECTAX_AGENT_SCAN_INTERVAL_SECONDS=30
RECTAX_AGENT_REQUEST_TIMEOUT_SECONDS=60
RECTAX_AGENT_STATE_FILE=./state/agent_state.json
RECTAX_AGENT_LOG_LEVEL=INFO
