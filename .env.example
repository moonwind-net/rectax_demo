# Example .env for RecTax
# Copy this file to `.env` and fill values. Do NOT commit your real `.env`.

# Example variables (customize for your environment)
JWT_SECRET=please-change-me
DATABASE_URL=postgresql://rectax:password@db/rectax
PADDLE_OCR_API_URL=http://paddle-ocr:8011
FRONTEND_BASE_URL=http://localhost:5173
# Core
POSTGRES_DB=receipt_tax_system
POSTGRES_USER=receipt_user
POSTGRES_PASSWORD=REPLACE_ME_DB_PASSWORD
DATABASE_URL=postgresql+asyncpg://receipt_user:REPLACE_ME_DB_PASSWORD@db:5432/receipt_tax_system

# Backend
DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
JWT_SECRET_KEY=REPLACE_ME_LONG_RANDOM_SECRET
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_ME_ADMIN_PASSWORD
BOOTSTRAP_ADMIN_DISPLAY_NAME=Admin
BOOTSTRAP_ADMIN_SYNC_EXISTING=true
ALLOWED_ORIGINS_JSON=["https://your-domain.com"]
ALLOWED_ORIGIN_REGEX=https://(.*\.)?your-domain\.com
UPLOAD_DIR=/app/uploads
EXPORT_DIR=/app/exports
MAX_FILE_SIZE=10485760
UPLOAD_RATE_LIMIT_PER_MINUTE=10
UPLOAD_MAX_FILES_PER_REQUEST=20
UPLOAD_MAX_TOTAL_MB_PER_REQUEST=100
FOLDER_WATCH_INTERVAL_SECONDS=300
WORKER_POLL_INTERVAL_SECONDS=3
WORKER_BATCH_SIZE=5
WORKER_CONCURRENCY=2
WORKER_MAX_ATTEMPTS=3
WORKER_RETRY_BASE_SECONDS=3
WORKER_MAX_QUEUE_DEPTH=2000

# OCR routing
PADDLE_OCR_TARGET=v4
PADDLE_OCR_API_URL_V3=http://paddle-ocr:8000/ocr/
PADDLE_OCR_API_URL_V4=http://paddle-ocr-v4:8000/ocr/
PADDLE_OCR_API_URL=http://paddle-ocr:8000/ocr/
PADDLE_OCR_TIMEOUT_SECONDS=30
RECEIPT_OCR_API_URL=http://receipt-ocr:8000/ocr/
RECEIPT_OCR_TIMEOUT_SECONDS=30

# Paddle services
PADDLE_OCR_PREFER_GPU=true
PADDLE_OCR_V4_VERSION=PP-OCRv4
PADDLE_OCR_DEBUG_REGISTRATION_CANDIDATES=false
PADDLE_OCR_DEBUG_REGISTRATION_CANDIDATES_MAX_CONFIDENCE=0.6

# Host paths
HOST_DATA_DIR=/data/rectax
HOST_UPLOADS_DIR=./uploads
HOST_EXPORTS_DIR=./exports

# Published ports
FRONTEND_PORT=80
BACKEND_PORT=8000
DB_PORT=5432
OCR_V3_PORT=8011
OCR_V4_PORT=8012
RECEIPT_OCR_PORT=8010

# Optional fallback LLM provider
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
