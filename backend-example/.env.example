# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://receipt_user:YOUR_DB_PASSWORD@localhost:5432/receipt_tax_system

# ── Security ──────────────────────────────────────────────────────────────────
# IMPORTANT: Generate a strong random key before deploying to production.
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_THIS_SECRET_KEY_IN_PRODUCTION
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Bootstrap admin user (created automatically if not exists)
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=admin123456
BOOTSTRAP_ADMIN_DISPLAY_NAME=Admin
BOOTSTRAP_ADMIN_SYNC_EXISTING=true

# ── Application ───────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false

# ── Storage ───────────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
EXPORT_DIR=./exports
MAX_FILE_SIZE=10485760

# ── OCR / Classification thresholds ──────────────────────────────────────────
OCR_CONFIDENCE_THRESHOLD=0.65
CLASSIFICATION_CONFIDENCE_THRESHOLD=0.70
PADDLE_OCR_TARGET=v3
PADDLE_OCR_API_URL_V3=http://paddle-ocr:8000/ocr/
PADDLE_OCR_API_URL_V4=http://paddle-ocr-v4:8000/ocr/
PADDLE_OCR_API_URL=http://paddle-ocr:8000/ocr/
PADDLE_OCR_TIMEOUT_SECONDS=30
RECEIPT_OCR_API_URL=http://receipt-ocr:8000/ocr/
RECEIPT_OCR_TIMEOUT_SECONDS=30

# ── Multi-tenancy defaults (MVP single-firm mode) ────────────────────────────
DEFAULT_FIRM_ID=1
DEFAULT_COMPANY_ID=1
DEFAULT_USER_ID=1

# ── Folder watch scheduler ────────────────────────────────────────────────────
FOLDER_WATCH_INTERVAL_SECONDS=300

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list passed at runtime or set as JSON array
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:8080"]
