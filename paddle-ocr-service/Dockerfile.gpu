FROM nvidia/cuda:12.2.2-cudnn8-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    LD_LIBRARY_PATH=/usr/local/cuda/lib64:/usr/lib/x86_64-linux-gnu:${LD_LIBRARY_PATH}

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-venv \
    libgl1 \
    libglib2.0-0 \
    libsm6 \
    libxrender1 \
    libxext6 \
    libgomp1 \
    && mkdir -p /usr/local/cuda/lib64 \
    && ln -sf /usr/lib/x86_64-linux-gnu/libcudnn.so.8 /usr/local/cuda/lib64/libcudnn.so \
    && ln -sf /usr/lib/x86_64-linux-gnu/libcudnn.so.8 /usr/local/cuda/lib64/libcudnn.so.8 \
    && bash -lc 'set -e; for lib in libcublas libcublasLt libcudart; do src=$(ls /usr/local/cuda/targets/x86_64-linux/lib/${lib}.so.* /usr/local/cuda/lib64/${lib}.so.* /usr/lib/x86_64-linux-gnu/${lib}.so.* 2>/dev/null | head -n 1 || true); if [ -n "$src" ]; then ln -sf "$src" /usr/local/cuda/lib64/${lib}.so; fi; done' \
    && rm -rf /var/lib/apt/lists/*

COPY ["app.py", "/app/app.py"]
COPY constraints.txt /app/constraints.txt

# Install app stack and GPU runtime for Paddle.
RUN python3 -m pip install --upgrade pip && \
    python3 -m pip install \
    fastapi==0.111.0 \
    uvicorn[standard]==0.30.1 \
    python-multipart==0.0.9 \
    Pillow==10.4.0 \
    numpy==1.26.4 \
    'opencv-python-headless>=4.10.0.84,<4.11.0.0' \
    'pypdfium2>=4.30.0,<5.0.0' \
    'paddleocr>=2.8.1,<2.9.0' \
    -c /app/constraints.txt && \
    python3 -m pip uninstall -y paddlepaddle || true && \
    python3 -m pip install 'paddlepaddle-gpu>=2.6.2,<2.7.0' -c /app/constraints.txt

EXPOSE 8000

CMD ["python3", "-m", "uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000"]
